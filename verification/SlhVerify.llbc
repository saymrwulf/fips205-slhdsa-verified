tation for more."},{"DocComment":""},{"DocComment":" [`cloned`]: Iterator::cloned"},{"DocComment":" [`Iterator`]: trait.Iterator.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":47,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["cycle",0]},{"Ident":["Cycle",0]}],"span":{"data":{"file_id":60,"beg":{"line":15,"col":0},"end":{"line":15,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator that repeats endlessly."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`cycle`] method on [`Iterator`]. See its"},{"DocComment":" documentation for more."},{"DocComment":""},{"DocComment":" [`cycle`]: Iterator::cycle"},{"DocComment":" [`Iterator`]: trait.Iterator.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":48,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["adapters",0]},{"Ident":["array_chunks",0]},{"Ident":["ArrayChunks",0]}],"span":{"data":{"file_id":61,"beg":{"line":19,"col":0},"end":{"line":19,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator over `N` elements of the iterator at a time."},{"DocComment":""},{"DocComment":" The chunks do not overlap. If `N` does not divide the length of the"},{"DocComment":" iterator, then the last up to `N-1` elements will be omitted."},{"DocComment":""},{"DocComment":" This `struct` is created by the [`array_chunks`][Iterator::array_chunks]"},{"DocComment":" method on [`Iterator`]. See its documentation for more."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"I"},{"index":1,"name":"Clause0_Item"}],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":390}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},{"def_id":49,"item_meta":{"name":[{"Ident":["fips205",0]},{"Ident":["types",0]},{"Ident":["WotsPk",0]}],"span":{"data":{"file_id":2,"beg":{"line":86,"col":0},"end":{"line":86,"col":61}},"generated_from_span":null},"source_text":"pub(crate) struct WotsPk<const N: usize>(pub(crate) [u8; N]);","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[{"index":0,"name":"N","ty":{"Deduplicated":390}}],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":{"Struct":[{"span":{"data":{"file_id":2,"beg":{"line":86,"col":41},"end":{"line":86,"col":59}},"generated_from_span":null},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":null,"ty":{"Deduplicated":8133}}]},"layout":[],"ptr_metadata":"None"},null,null,{"def_id":52,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["pin",0]},{"Ident":["Pin",0]}],"span":{"data":{"file_id":64,"beg":{"line":1092,"col":0},"end":{"line":1092,"col":19}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A pointer which pins its pointee in place."},{"DocComment":""},{"DocComment":" [`Pin`] is a wrapper around some kind of pointer `Ptr` which makes that pointer \"pin\" its"},{"DocComment":" pointee value in place, thus preventing the value referenced by that pointer from being moved"},{"DocComment":" or otherwise invalidated at that place in memory unless it implements [`Unpin`]."},{"DocComment":""},{"DocComment":" *See the [`pin` module] documentation for a more thorough exploration of pinning.*"},{"DocComment":""},{"DocComment":" ## Pinning values with [`Pin<Ptr>`]"},{"DocComment":""},{"DocComment":" In order to pin a value, we wrap a *pointer to that value* (of some type `Ptr`) in a"},{"DocComment":" [`Pin<Ptr>`]. [`Pin<Ptr>`] can wrap any pointer type, forming a promise that the **pointee**"},{"DocComment":" will not be *moved* or [otherwise invalidated][subtle-details]. If the pointee value's type"},{"DocComment":" implements [`Unpin`], we are free to disregard these requirements entirely and can wrap any"},{"DocComment":" pointer to that value in [`Pin`] directly via [`Pin::new`]. If the pointee value's type does"},{"DocComment":" not implement [`Unpin`], then Rust will not let us use the [`Pin::new`] function directly and"},{"DocComment":" we'll need to construct a [`Pin`]-wrapped pointer in one of the more specialized manners"},{"DocComment":" discussed below."},{"DocComment":""},{"DocComment":" We call such a [`Pin`]-wrapped pointer a **pinning pointer** (or pinning ref, or pinning"},{"DocComment":" [`Box`], etc.) because its existence is the thing that is pinning the underlying pointee in"},{"DocComment":" place: it is the metaphorical \"pin\" securing the data in place on the pinboard (in memory)."},{"DocComment":""},{"DocComment":" It is important to stress that the thing in the [`Pin`] is not the value which we want to pin"},{"DocComment":" itself, but rather a pointer to that value! A [`Pin<Ptr>`] does not pin the `Ptr` but rather"},{"DocComment":" the pointer's ***pointee** value*."},{"DocComment":""},{"DocComment":" The most common set of types which require pinning related guarantees for soundness are the"},{"DocComment":" compiler-generated state machines that implement [`Future`] for the return value of"},{"DocComment":" `async fn`s. These compiler-generated [`Future`]s may contain self-referential pointers, one"},{"DocComment":" of the most common use cases for [`Pin`]. More details on this point are provided in the"},{"DocComment":" [`pin` module] docs, but suffice it to say they require the guarantees provided by pinning to"},{"DocComment":" be implemented soundly."},{"DocComment":""},{"DocComment":" This requirement for the implementation of `async fn`s means that the [`Future`] trait"},{"DocComment":" requires all calls to [`poll`] to use a <code>self: [Pin]\\<&mut Self></code> parameter instead"},{"DocComment":" of the usual `&mut self`. Therefore, when manually polling a future, you will need to pin it"},{"DocComment":" first."},{"DocComment":""},{"DocComment":" You may notice that `async fn`-sourced [`Future`]s are only a small percentage of all"},{"DocComment":" [`Future`]s that exist, yet we had to modify the signature of [`poll`] for all [`Future`]s"},{"DocComment":" to accommodate them. This is unfortunate, but there is a way that the language attempts to"},{"DocComment":" alleviate the extra friction that this API choice incurs: the [`Unpin`] trait."},{"DocComment":""},{"DocComment":" The vast majority of Rust types have no reason to ever care about being pinned. These"},{"DocComment":" types implement the [`Unpin`] trait, which entirely opts all values of that type out of"},{"DocComment":" pinning-related guarantees. For values of these types, pinning a value by pointing to it with a"},{"DocComment":" [`Pin<Ptr>`] will have no actual effect."},{"DocComment":""},{"DocComment":" The reason this distinction exists is exactly to allow APIs like [`Future::poll`] to take a"},{"DocComment":" [`Pin<Ptr>`] as an argument for all types while only forcing [`Future`] types that actually"},{"DocComment":" care about pinning guarantees pay the ergonomics cost. For the majority of [`Future`] types"},{"DocComment":" that don't have a reason to care about being pinned and therefore implement [`Unpin`], the"},{"DocComment":" <code>[Pin]\\<&mut Self></code> will act exactly like a regular `&mut Self`, allowing direct"},{"DocComment":" access to the underlying value. Only types that *don't* implement [`Unpin`] will be restricted."},{"DocComment":""},{"DocComment":" ### Pinning a value of a type that implements [`Unpin`]"},{"DocComment":""},{"DocComment":" If the type of the value you need to \"pin\" implements [`Unpin`], you can trivially wrap any"},{"DocComment":" pointer to that value in a [`Pin`] by calling [`Pin::new`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" // Create a value of a type that implements `Unpin`"},{"DocComment":" let mut unpin_future = std::future::ready(5);"},{"DocComment":""},{"DocComment":" // Pin it by creating a pinning mutable reference to it (ready to be `poll`ed!)"},{"DocComment":" let my_pinned_unpin_future: Pin<&mut _> = Pin::new(&mut unpin_future);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### Pinning a value inside a [`Box`]"},{"DocComment":""},{"DocComment":" The simplest and most flexible way to pin a value that does not implement [`Unpin`] is to put"},{"DocComment":" that value inside a [`Box`] and then turn that [`Box`] into a \"pinning [`Box`]\" by wrapping it"},{"DocComment":" in a [`Pin`]. You can do both of these in a single step using [`Box::pin`]. Let's see an"},{"DocComment":" example of using this flow to pin a [`Future`] returned from calling an `async fn`, a common"},{"DocComment":" use case as described above."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" async fn add_one(x: u32) -> u32 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // Call the async function to get a future back"},{"DocComment":" let fut = add_one(42);"},{"DocComment":""},{"DocComment":" // Pin the future inside a pinning box"},{"DocComment":" let pinned_fut: Pin<Box<_>> = Box::pin(fut);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you have a value which is already boxed, for example a [`Box<dyn Future>`][Box], you can pin"},{"DocComment":" that value in-place at its current memory address using [`Box::into_pin`]."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::pin::Pin;"},{"DocComment":" use std::future::Future;"},{"DocComment":""},{"DocComment":" async fn add_one(x: u32) -> u32 {"},{"DocComment":"     x + 1"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn boxed_add_one(x: u32) -> Box<dyn Future<Output = u32>> {"},{"DocComment":"     Box::new(add_one(x))"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let boxed_fut = boxed_add_one(42);"},{"DocComment":""},{"DocComment":" // Pin the future inside the existing box"},{"DocComment":" let pinned_fut: Pin<Box<_>> = Box::into_pin(boxed_fut);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are similar pinning methods offered on the other standard library smart pointer types"},{"DocComment":" as well, like [`Rc`] and [`Arc`]."},{"DocComment":""},{"DocComment":" ### Pinning a value on the stack using [`pin!`]"},{"DocComment":""},{"DocComment":" There are some situations where it is desirable or even required (for example, in a `#[no_std]`"},{"DocComment":" context where you don't have access to the standard library or allocation in general) to"},{"DocComment":" pin a value which does not implement [`Unpin`] to its location on the stack. Doing so is"},{"DocComment":" possible using the [`pin!`] macro. See its documentation for more."},{"DocComment":""},{"DocComment":" ## Layout and ABI"},{"DocComment":""},{"DocComment":" [`Pin<Ptr>`] is guaranteed to have the same memory layout and ABI[^noalias] as `Ptr`."},{"DocComment":""},{"DocComment":" [^noalias]: There is a bit of nuance here that is still being decided about whether the"},{"DocComment":" aliasing semantics of `Pin<&mut T>` should be different than `&mut T`, but this is true as of"},{"DocComment":" today."},{"DocComment":""},{"DocComment":" [`pin!`]: crate::pin::pin \"pin!\""},{"DocComment":" [`Future`]: crate::future::Future \"Future\""},{"DocComment":" [`poll`]: crate::future::Future::poll \"Future::poll\""},{"DocComment":" [`Future::poll`]: crate::future::Future::poll \"Future::poll\""},{"DocComment":" [`pin` module]: self \"pin module\""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html \"Rc\""},{"DocComment":" [`Arc`]: ../../std/sync/struct.Arc.html \"Arc\""},{"DocComment":" [Box]: ../../std/boxed/struct.Box.html \"Box\""},{"DocComment":" [`Box`]: ../../std/boxed/struct.Box.html \"Box\""},{"DocComment":" [`Box::pin`]: ../../std/boxed/struct.Box.html#method.pin \"Box::pin\""},{"DocComment":" [`Box::into_pin`]: ../../std/boxed/struct.Box.html#method.into_pin \"Box::into_pin\""},{"DocComment":" [subtle-details]: self#subtle-details-and-the-drop-guarantee \"pin subtle details\""},{"DocComment":" [`unsafe`]: ../../std/keyword.unsafe.html \"keyword unsafe\""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"pin"},"generics":{"regions":[],"types":[{"index":0,"name":"Ptr"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[],"ptr_metadata":"None"},null,{"def_id":54,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Ident":["niche_types",0]},{"Ident":["NonZeroUsizeInner",0]}],"span":{"data":{"file_id":66,"beg":{"line":20,"col":8},"end":{"line":20,"col":55}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"TopLevel","kind":"Opaque","layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":8,"align":8,"discriminator":{"Known":0},"uninhabited":false,"variant_layouts":[{"field_offsets":[0],"uninhabited":false,"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":false}}}],"ptr_metadata":"None"},null,null,{"def_id":57,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["control_flow",0]},{"Ident":["ControlFlow",0]}],"span":{"data":{"file_id":67,"beg":{"line":89,"col":0},"end":{"line":89,"col":31}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to tell an operation whether it should exit early or go on as usual."},{"DocComment":""},{"DocComment":" This is used when exposing things (like graph traversals or visitors) where"},{"DocComment":" you want the user to be able to choose whether to exit early."},{"DocComment":" Having the enum makes it clearer -- no more wondering \"wait, what did `false`"},{"DocComment":" mean again?\" -- and allows including a value."},{"DocComment":""},{"DocComment":" Similar to [`Option`] and [`Result`], this enum can be used with the `?` operator"},{"DocComment":" to return immediately if the [`Break`] variant is present or otherwise continue normally"},{"DocComment":" with the value inside the [`Continue`] variant."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Early-exiting from [`Iterator::try_for_each`]:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let r = (2..100).try_for_each(|x| {"},{"DocComment":"     if 403 % x == 0 {"},{"DocComment":"         return ControlFlow::Break(x)"},{"DocComment":"     }"},{"DocComment":""},{"DocComment":"     ControlFlow::Continue(())"},{"DocComment":" });"},{"DocComment":" assert_eq!(r, ControlFlow::Break(13));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" A basic tree traversal:"},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" pub struct TreeNode<T> {"},{"DocComment":"     value: T,"},{"DocComment":"     left: Option<Box<TreeNode<T>>>,"},{"DocComment":"     right: Option<Box<TreeNode<T>>>,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl<T> TreeNode<T> {"},{"DocComment":"     pub fn traverse_inorder<B>(&self, f: &mut impl FnMut(&T) -> ControlFlow<B>) -> ControlFlow<B> {"},{"DocComment":"         if let Some(left) = &self.left {"},{"DocComment":"             left.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         f(&self.value)?;"},{"DocComment":"         if let Some(right) = &self.right {"},{"DocComment":"             right.traverse_inorder(f)?;"},{"DocComment":"         }"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":"     fn leaf(value: T) -> Option<Box<TreeNode<T>>> {"},{"DocComment":"         Some(Box::new(Self { value, left: None, right: None }))"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let node = TreeNode {"},{"DocComment":"     value: 0,"},{"DocComment":"     left: TreeNode::leaf(1),"},{"DocComment":"     right: Some(Box::new(TreeNode {"},{"DocComment":"         value: -1,"},{"DocComment":"         left: TreeNode::leaf(5),"},{"DocComment":"         right: TreeNode::leaf(2),"},{"DocComment":"     }))"},{"DocComment":" };"},{"DocComment":" let mut sum = 0;"},{"DocComment":""},{"DocComment":" let res = node.traverse_inorder(&mut |val| {"},{"DocComment":"     if *val < 0 {"},{"DocComment":"         ControlFlow::Break(*val)"},{"DocComment":"     } else {"},{"DocComment":"         sum += *val;"},{"DocComment":"         ControlFlow::Continue(())"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(res, ControlFlow::Break(-1));"},{"DocComment":" assert_eq!(sum, 6);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`Break`]: ControlFlow::Break"},{"D