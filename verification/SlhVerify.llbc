ile bits < b {\n            //\n            // 6: total ← (total ≪ 8) + X[in]\n            total = (total << 8) + u32::from(x[inn]);\n\n            // 7: in ← in + 1\n            inn += 1;\n\n            // 8: bits ← bits + 8\n            bits += 8;\n\n            // 9: end while\n        }\n\n        // 10: bits ← bits − b\n        bits -= b;\n\n        // 11: baseb[out] ← (total ≫ bits) mod 2^b\n        baseb[out] = (total >> bits) & (u32::MAX >> (32 - b));\n\n        // 12: end for\n    }\n\n    // 13: return baseb  (mutable parameter)\n}","attr_info":{"attributes":[{"DocComment":" Algorithm 4: `base_2^b(X, b, out_len)` on page 16."},{"DocComment":" Computes the base 2^b representation of X."},{"DocComment":""},{"DocComment":" Input: Byte string `X` of length at least `ceil(out_len·b/8)`, integer `b`, output length `out_len`. <br>"},{"DocComment":" Output: Array of `out_len` integers in the range `[0, . . . , 2^b − 1]`."}],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","inputs":[{"Deduplicated":8230},{"Deduplicated":490},{"Deduplicated":490},{"HashConsedValue":[8341,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":2440},"Mut"]}]}],"output":{"Deduplicated":416}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":11,"beg":{"line":68,"col":0},"end":{"line":114,"col":1}},"generated_from_span":null},"bound_body_regions":35,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":11,"beg":{"line":68,"col":72},"end":{"line":68,"col":72}},"generated_from_span":null},"ty":{"Deduplicated":416}},{"index":1,"name":"x","span":{"data":{"file_id":11,"beg":{"line":68,"col":22},"end":{"li